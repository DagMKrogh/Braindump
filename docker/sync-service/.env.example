# ── Database ──────────────────────────────────────────────────────────────────
# Used by the bundled Postgres service (service-to-service URL is auto-built)
POSTGRES_USER=braindump
POSTGRES_PASSWORD=change-me-use-a-strong-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-use-openssl-rand-base64-32

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# ── Origins ───────────────────────────────────────────────────────────────────
# The URL where the Braindump web app is served (used for CORS + redirect)
ALLOWED_ORIGIN=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Exposed port on the host (default 3001)
PORT=3001

# API key for the /ingest endpoint (leave blank to disable)
INGEST_API_KEY=
