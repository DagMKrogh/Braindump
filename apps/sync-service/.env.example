PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/braindump
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback
ALLOWED_ORIGIN=https://your-domain.com
NODE_ENV=production
# Machine-to-machine ingest API key (for /braindump Claude skill and other integrations)
# Set INGEST_API_KEY here and BRAINDUMP_API_KEY to the same value in your shell (~/.zshrc)
INGEST_API_KEY=change-me-to-a-random-secret
